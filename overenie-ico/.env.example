# --- Povinné ---
# Tajný kľúč na podpisovanie prihlásení (aspoň 32 znakov). Vygenerujte napr.: openssl rand -hex 32
SESSION_SECRET=

# Prvý administrátor (alebo viacerí, oddelení čiarkou) a jeho jednorazový kód na prvé prihlásenie.
# Po nastavení hesla môžete ADMIN_SETUP_CODE z Vercelu zmazať.
ADMIN_EMAILS=
ADMIN_SETUP_CODE=

# Databáza používateľov a protokolu – Upstash Redis (Vercel → Storage → Upstash for Redis → Connect).
# Vercel tieto premenné doplní sám. Lokálne bez nich beží dočasná pamäťová databáza.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Odporúčané ---
# Bezplatný API kľúč Finančnej správy SR (https://opendata.financnasprava.sk/page/openapi).
# Bez neho sa daňové kontroly označia ako "na manuálne overenie".
FS_API_KEY=

# Predvolená verzia pre nových používateľov: firma (predvolené) alebo advokat
APP_MODE=firma

# --- Záložné AI vyhľadávanie (voliteľné) ---
# Produkcia: kľúč len tu (Claude ALEBO OpenAI). Lokálne ho môže admin zadať aj v Administrácii.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai (ak sú zadané oba kľúče)
AI_PROVIDER=
# prázdne = claude-sonnet-5 / gpt-5.5
AI_MODEL=
# 0 = AI sa nespúšťa automaticky pri zlyhaní zdroja (len tlačidlom)
AI_AUTO_FALLBACK=1
# 0 = AI neoveruje automaticky registre bez API (VšZP, Union, OV, diskvalifikácie, ÚVO)
AI_NO_API_SOURCES=1
# 1 = povoliť zadanie AI kľúča v Administrácii aj v produkcii (neodporúča sa)
AI_ALLOW_ADMIN_KEY=

# Lokálne vyskúšanie bez registrov – vymyslené testovacie údaje (v produkcii sa ignoruje)
DEMO_DATA=
